# Copy to backend/.env and edit. NEVER commit the real file.
APP_NAME=CineSphere
ENV=dev                         # dev exposes password-reset tokens in the API response (no SMTP). Use "prod" in production.
DATABASE_URL=postgresql+psycopg2://cinesphere:cinesphere@localhost:5432/cinesphere
SECRET_KEY=change-me-to-a-long-random-string     # python -c "import secrets;print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false             # true when served over HTTPS
SEAT_LOCK_SECONDS=300           # how long a seat hold lasts
MAX_SEATS_PER_BOOKING=10
TAX_RATE=0.18
CONVENIENCE_FEE_PER_TICKET=2000 # paise
# Development-only accounts created by `python -m app.seed`
ADMIN_EMAIL=admin@cinesphere.example.com
ADMIN_PASSWORD=Admin@12345
DEMO_USER_EMAIL=demo@cinesphere.example.com
DEMO_USER_PASSWORD=Demo@12345
